APP_ENV=production
APP_URL=https://your-production-domain.example
PUBLIC_APP_URL=https://your-production-domain.example
PAYMONGO_PUBLIC_BASE_URL=https://your-production-domain.example
# Optional process-level override. The resolved file must be outside the web document root.
# ITOUR_PRIVATE_ENV_PATH=C:/xampp/private/itour-mercedes.env
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_PUBLIC_KEY=pk_test_replace_me
# Missing mode defaults to test for existing deployments. Set all live values together.
PAYMONGO_MODE=test
PAYMONGO_WEBHOOK_ID=
PAYMONGO_WEBHOOK_SECRET=
# Required dedicated key for new encrypted refund/payout destinations.
# Preserve its existing value when changing PayMongo credentials.
REFUND_DESTINATION_ENCRYPTION_KEY=
# Optional decrypt-only material for destinations saved by the old integration.
# If needed, retain the previous PAYMONGO_SECRET_KEY here before rotating it.
REFUND_LEGACY_DESTINATION_ENCRYPTION_KEY=
PAYMONGO_TIMEOUT_SECONDS=30
PAYMONGO_CA_BUNDLE=
PAYMONGO_API_RESOLVE=
PAYMONGO_DNS_SERVERS=
PAYMONGO_CA_PATH=
LOCAL_APP_URL=http://localhost/Mercedes%20Eco%20Tour%20Website
