APP_ENV=production
APP_URL=https://your-production-domain.example
PUBLIC_APP_URL=https://your-production-domain.example
PAYMONGO_PUBLIC_BASE_URL=https://your-production-domain.example
# Optional process-level override. The resolved file must be outside the web document root.
# ITOUR_PRIVATE_ENV_PATH=C:/xampp/private/itour-mercedes.env
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_PUBLIC_KEY=pk_test_replace_me
PAYMONGO_WEBHOOK_ID=
PAYMONGO_WEBHOOK_SECRET=
# Optional dedicated key used to encrypt tourist refund account numbers at rest.
# When omitted, the server derives an encryption key from PAYMONGO_SECRET_KEY.
REFUND_DESTINATION_ENCRYPTION_KEY=
PAYMONGO_TIMEOUT_SECONDS=30
PAYMONGO_CA_BUNDLE=
PAYMONGO_DNS_SERVERS=
PAYMONGO_CA_PATH=
LOCAL_APP_URL=http://localhost/Mercedes%20Eco%20Tour%20Website
