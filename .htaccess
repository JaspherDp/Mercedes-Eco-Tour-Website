# Prevent credentials, repository metadata, and deployment artifacts from
# being served when this project directory is an Apache/LiteSpeed document root.
Options -Indexes

# Load the PHP homepage when visiting the root domain.
DirectoryIndex index.php

# Central response-header policy. HSTS is deliberately limited to HTTPS
# requests. Hostinger CDN terminates TLS before forwarding some requests, so
# accept its HTTPS forwarding marker as well as Apache's direct HTTPS state.
<IfModule mod_setenvif.c>
    SetEnvIfExpr "%{HTTPS} == 'on'" ITOUR_HTTPS
    SetEnvIf X-Forwarded-Proto "^https$" ITOUR_HTTPS
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} =on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} ^https$ [NC]
    RewriteRule ^ - [E=ITOUR_HTTPS:1]
</IfModule>

<IfModule mod_headers.c>
    # Clear inherited/application copies before setting one canonical value.
    Header unset Strict-Transport-Security
    Header always unset Strict-Transport-Security
    # One-year policy for the production domain. Subdomains are intentionally
    # excluded because their HTTPS coverage is not part of this policy.
    Header always set Strict-Transport-Security "max-age=31536000" env=ITOUR_HTTPS

    Header unset X-Content-Type-Options
    Header always unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"

    # Same-origin framing is required by the site's internal document previews.
    Header unset X-Frame-Options
    Header always unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"

    Header unset Referrer-Policy
    Header always unset Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header unset Permissions-Policy
    Header always unset Permissions-Policy
    Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(self), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), picture-in-picture=(self), usb=()"

    # Inline code remains allowed because existing pages depend on it. All
    # network sources are restricted to services currently used by the site.
    Header unset Content-Security-Policy
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://html2canvas.hertzen.com https://challenges.cloudflare.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://unpkg.com https://images.unsplash.com https://profiles.google.com https://*.googleusercontent.com https://img.icons8.com https://*.tile.openstreetmap.org https://picsum.photos; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com https://*.googleapis.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com; worker-src 'self' blob:; manifest-src 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Temporary production HTTPS redirect. Local/private XAMPP hosts remain on
    # HTTP. Change R=302 to R=308 only after the deployed SSL flows are verified.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1|\[?::1\]?)(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^(?:10\.|192\.168\.|172\.(?:1[6-9]|2[0-9]|3[01])\.) [NC]
    RewriteCond %{HTTP_HOST} ^([A-Z0-9.-]+)(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=302,L]

    # Temporary canonical redirect for the retired homepage filename.
    # Capture only URL path segments so production roots and XAMPP subdirectories
    # canonicalize safely without trusting Host headers or exposing filesystem paths.
    RewriteCond %{THE_REQUEST} "\s/+((?:[^/?\x20]+/)*)homepage\.php(?:[?\x20])" [NC]
    RewriteRule ^homepage\.php$ /%1 [R=302,L,NE]
    RewriteRule "(^|/)\.(?:git|svn|hg)(?:/|$)" - [F,L,NC]
    RewriteRule "(^|/)backups(?:/|$)" - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)(?:^\.env(?:\..*)?$|^\.(?:git|svn|hg)|^composer\.(?:json|lock)$|^debug(?:[_-].*)?\.(?:txt|log|json)$|.*(?:credential|service[-_.]?account|backup|database[-_.]?dump).*\.json$|.*\.(?:ini|log|sql|dump|bak|backup|old|orig|save|tmp|key|pem|p12|pfx|zip|tar|tar\.gz|tgz|gz|7z)$)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)(?:^\.env(?:\..*)?$|^\.(?:git|svn|hg)|^composer\.(?:json|lock)$|^debug(?:[_-].*)?\.(?:txt|log|json)$|.*(?:credential|service[-_.]?account|backup|database[-_.]?dump).*\.json$|.*\.(?:ini|log|sql|dump|bak|backup|old|orig|save|tmp|key|pem|p12|pfx|zip|tar|tar\.gz|tgz|gz|7z)$)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
